using System;
using Game.Foundation.Gui;

// 卡牌竞技 · CARDARENA 入口：建宿主 → 跑主循环。
//
// 参考源：Qsgs-Fans/FreeKill（GPL-3.0；Lua 主体已迁到 freekill-core）。
// ⚠️ 美术 IP 红线：FreeKill 的 26 张武将立绘是**三国杀原作（游卡）美术**，
// 官方文档甚至写"三国杀的皮肤那么多，尽情选择吧"——未获原作再授权，
// 不可商用移植。本项目只借鉴其**声明式技能系统**的架构思路，卡面 / 立绘 /
// 图标全部自研。
//
// 环境变量：
//   CARDARENA_SMOKE=1     无头冒烟（双方自动对战，跑满帧数退出）
//   CARDARENA_FRAMES=<n>  冒烟帧数上限
//   CARDARENA_DEMO=1      演示模式（直接进对战，玩家座位空着）
//   CARDARENA_BUILD=1     直接进构筑界面
//   CARDARENA_CAPTURE=<path>  抓一帧画布像素（后端画布，非窗口）
//   CARDARENA_SAVE=<dir>  存档目录（测试脚本用临时目录）
public class CardArenaApp {
    static void Main() {
        CardGame app = new CardGame();
        GuiHost host = new GuiHost("卡牌竞技 · CARDARENA", 1280, 800, 16);
        host.Run(app);
    }
}
