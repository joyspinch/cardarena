using System;
using Gui;
using Game.Kit;

// 逻辑坐标下的画布原语：把 CDraw 的视口映射包一层，
// 让界面布局全部写在逻辑像素里（1280×800 设计分辨率）。
//
// 通用绘制原语**不再在这里实现**——九宫格切图归 Game.Kit.CKitSlice、
// 裁源贴图归 Game.Kit.CDraw.BlitImageSrcKey、文字（普通/居中/右对齐/阴影/
// 描边）归 Game.Kit.CText。同一件事此前在 8 个游戏项目各写一份，签名漂成
// 8 种，阴影与描边的偏移也各写各的。
//
// 本文件剩下的是**形状**原语与本项目的底板倍率常量。
public class CardPaint {
    // 底板按**显示尺寸 2 倍**入库（与卡面底板同一口径），因此九宫格
    // 的源内缩量要折半才是逻辑像素的角宽——调 CKitSlice.NineSlice 的
    // targetScale 时传这个值。
    public const int PlateScale = 2;

    public static int X(int v) { return CDraw.MapX(v + CDraw.originX); }
    public static int Y(int v) { return CDraw.MapY(v + CDraw.originY); }
    public static int S(int v) { return CDraw.MapW(v); }

    public static void Fill(Canvas c, int x, int y, int w, int h, int color) {
        if (w <= 0 || h <= 0) { return; }
        c.FillRect(CardPaint.X(x), CardPaint.Y(y), CardPaint.S(w), CardPaint.S(h), color);
    }

    public static void VGrad(Canvas c, int x, int y, int w, int h,
                             int colorTop, int colorBottom) {
        if (w <= 0 || h <= 0) { return; }
        c.FillVGrad(CardPaint.X(x), CardPaint.Y(y), CardPaint.S(w), CardPaint.S(h),
                    colorTop, colorBottom);
    }

    public static void Rect(Canvas c, int x, int y, int w, int h, int color, int t) {
        if (w <= 0 || h <= 0 || t <= 0) { return; }
        c.DrawRect(CardPaint.X(x), CardPaint.Y(y), CardPaint.S(w), CardPaint.S(h), color, CardPaint.S(t));
    }

    public static void Round(Canvas c, int x, int y, int w, int h, int rad, int color, int t) {
        if (w <= 0 || h <= 0 || t <= 0) { return; }
        c.DrawRoundRect(CardPaint.X(x), CardPaint.Y(y), CardPaint.S(w), CardPaint.S(h),
                        CardPaint.S(rad), color, CardPaint.S(t));
    }

    public static void FillRound(Canvas c, int x, int y, int w, int h, int rad, int color) {
        if (w <= 0 || h <= 0) { return; }
        c.FillRoundRect(CardPaint.X(x), CardPaint.Y(y), CardPaint.S(w), CardPaint.S(h),
                        CardPaint.S(rad), color);
    }

    public static void FillCircle(Canvas c, int cx, int cy, int rad, int color) {
        if (rad <= 0) { return; }
        c.FillCircle(CardPaint.X(cx), CardPaint.Y(cy), CardPaint.S(rad), color);
    }

    public static void Circle(Canvas c, int cx, int cy, int rad, int color, int t) {
        if (rad <= 0 || t <= 0) { return; }
        c.DrawCircle(CardPaint.X(cx), CardPaint.Y(cy), CardPaint.S(rad), color, CardPaint.S(t));
    }

    public static void Line(Canvas c, int x0, int y0, int x1, int y1, int color, int t) {
        if (t <= 0) { return; }
        c.DrawLine(CardPaint.X(x0), CardPaint.Y(y0), CardPaint.X(x1), CardPaint.Y(y1),
                   color, CardPaint.S(t));
    }
}
