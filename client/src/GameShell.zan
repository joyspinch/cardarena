using System;
using System.Collections.Generic;
using System.IO;
using System.Json;
using Game.Foundation;
using Game.Foundation.Gui;

// 卡牌竞技 · CARDARENA 的外壳：存档（累计胜场 / 败场 / 场次 / 最高回合数）
// + 设置（对手强度 / 每回合能量 / 自动出牌）+ 设置浮层。
//
// 存档基座（原子写 + 备份回退 + 版本号）与设置逻辑层（档位计算 + 校验 +
// 落盘）都在公共包 Game.Foundation 里；这里只留"这个游戏存什么、设置有几
// 项"——换个游戏换的正是这两行。
public class GameShell {
    GameSaveStore store;
    GameSettings settings;
    SettingsModel model;
    SettingsOverlay overlay;
    int wins;         // 累计胜场
    int losses;       // 累计败场
    int runs;         // 累计场次
    int bestRounds;   // 最高回合数

    public GameShell() {
        string dir = GameShell.SaveDir();
        Directory.CreateDirectory(dir);
        this.store = new GameSaveStore(dir, "cardarena", 2);
        this.settings = new GameSettings().At(dir + "/settings.json");
        // 对手强度：AI 的判断深度（1 只会打 / 2 会回血 / 3 会抢能量）。
        this.settings.AddIntChoice("difficulty", "对手强度", 2,
            new List<int> { 1, 2, 3 });
        // 每回合能量：直接决定出牌速度（2/3/4）。
        this.settings.AddIntChoice("energy", "每回合能量", 3,
            new List<int> { 2, 3, 4 });
        // 自动出牌：勾上后自己的座位也交给 AI 代打（观战模式）。
        this.settings.AddBool("autoPlay", "自动出牌", false);
        this.settings.Load();
        this.model = new SettingsModel(this.settings);
        this.overlay = new SettingsOverlay(this.model);
        this.overlay.SetTitle("设置");
        this.overlay.SetCloseText("关闭");
        this.Load();
    }

    // 存档目录：%LOCALAPPDATA%/Cardarena（可用 CARDARENA_SAVE 环境变量覆盖，
    // 测试脚本靠它把存档落在临时目录里，不污染玩家机器）。
    static string SaveDir() {
        string overridden = Environment.GetEnvironmentVariable("CARDARENA_SAVE");
        if (overridden != "") { return overridden; }
        string basePath = Environment.GetEnvironmentVariable("LOCALAPPDATA");
        if (basePath == "") { basePath = Directory.GetCurrentDirectory(); }
        return basePath + "/Cardarena";
    }

    public SettingsOverlay Overlay() { return this.overlay; }
    public int Wins() { return this.wins; }
    public int Losses() { return this.losses; }
    public int Runs() { return this.runs; }
    public int Best() { return this.bestRounds; }

    // 当前对手强度（1/2/3）——AI 选牌的判断深度。
    public int Difficulty() {
        if (this.settings == null) { return 2; }
        return this.settings.GetInt("difficulty");
    }

    // 每回合能量（2/3/4）。
    public int EnergyPerTurn() {
        if (this.settings == null) { return 3; }
        return this.settings.GetInt("energy");
    }

    // 是否自动出牌（自己的座位交给 AI）。
    public bool AutoPlay() {
        if (this.settings == null) { return false; }
        return this.settings.GetBool("autoPlay");
    }

    // 读档：没有存档就用默认值，不报错。
    public void Load() {
        JsonValue data = this.store.Load(0);
        if (data == null) {
            this.wins = 0; this.losses = 0; this.runs = 0; this.bestRounds = 0;
            return;
        }
        this.wins = data.Int("wins", 0);
        this.losses = data.Int("losses", 0);
        this.runs = data.Int("runs", 0);
        this.bestRounds = data.Int("bestRounds", 0);
    }

    // 记一局：场次 +1，胜/败分账，最高回合数只增不减。
    // result：1 = 玩家胜，0 = 玩家负，-1 = 平局。
    public void RecordBattle(int rounds, int result) {
        this.runs = this.runs + 1;
        if (result == 1) { this.wins = this.wins + 1; }
        else if (result == 0) { this.losses = this.losses + 1; }
        if (rounds > this.bestRounds) { this.bestRounds = rounds; }
    }

    // 存档落盘（存档本身不改计数——计数由 RecordBattle 负责）。
    public void Save() {
        JsonValue data = JsonValue.NewObject();
        data.PutInt("wins", this.wins);
        data.PutInt("losses", this.losses);
        data.PutInt("runs", this.runs);
        data.PutInt("bestRounds", this.bestRounds);
        this.store.Save(0, data);
    }
}
